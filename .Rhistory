geom_line(data = data.frame(night_length = new_kendall$night_length, time_to_sunset = predictions$fit),
aes(x = night_length, y = time_to_sunset), color = "blue", size = 1) +
geom_ribbon(data = data.frame(night_length = new_kendall$night_length, fit = predictions$fit,
se = predictions$se.fit), aes(x = night_length,
ymin = fit - 1.96 * se,
ymax = fit + 1.96 * se), alpha = 0.3) +
labs(
x = "Night length (min)", y = "Departure time after sunset (min)") +
theme_minimal() + theme(axis.title = element_text(size = 16), strip.text = element_text(size = 20), legend.text = element_text(size = 13), legend.title = element_text(size = 16))
#Very weak correlation, so probably not as significant as the p shows
model.k.moon = mblm(time_to_sunset ~ moonlightModel,
data = season_filter)
summary(model.k.moon)
confint(model.k.moon)
new_kendall_moon <- data.frame(moonlightModel = seq(min(season_filter$moonlightModel), max(season_filter$moonlightModel),
length.out = 207))
###
predictions_moon <- predict(model.k.moon, newdata = new_kendall_moon, type = "response", se.fit = TRUE)
# Plot the data and the kendall fit
ggplot() +
geom_point(data = season_filter, aes(x = moonlightModel, y = time_to_sunset, color = season)) +
geom_line(data = data.frame(moonlightModel = new_kendall_moon$moonlightModel, time_to_sunset = predictions_moon$fit),
aes(x = moonlightModel, y = time_to_sunset), color = "blue", size = 1) +
geom_ribbon(data = data.frame(moonlightModel = new_kendall_moon$moonlightModel, fit = predictions_moon$fit,
se = predictions_moon$se.fit), aes(x = moonlightModel,
ymin = fit - 1.96 * se,
ymax = fit + 1.96 * se), alpha = 0.3) +
labs(
x = "Moonlight illumination", y = "Departure time after sunset (min)") +
theme_minimal() + theme(axis.title = element_text(size = 16), strip.text = element_text(size = 20), legend.text = element_text(size = 13), legend.title = element_text(size = 16))
