print(wilcox_sekrn)
wilcox_sekaa <- wilcox.test(fall_sekaa$time_to_sunset, spring_sekaa$time_to_sunset, paired = FALSE, var.equal = TRUE, alternative = "greater", conf.int = TRUE, conf.level = 0.95)
print(wilcox_sekaa)
wilcox <- wilcox.test(fall_season$time_to_sunset, spring_season$time_to_sunset, paired = FALSE, var.equal = TRUE, alternative = "greater", conf.int = TRUE, conf.level = 0.95)
#Spring histogram
season_filter %>%
filter(season == "spring") -> spring_season
ggplot(data = spring_season, aes(x = time_to_sunset )) +
geom_histogram(binwidth = 5) +
labs(title = "Histogram of departure time spring", x = "Departure time", y = "Count")
#Normality test
shapiro.test(spring_season$time_to_sunset)
#Not normal W = 0.71758, p-value = 0.00001268
#Fall histogram
season_filter %>%
filter(season == "fall") -> fall_season
ggplot(data = fall_season, aes(x = time_to_sunset )) +
geom_histogram(binwidth = 5) +
labs(title = "Histogram of departure time fall", x = "Departure time", y = "Count")
#Normality test
shapiro.test(fall_season$time_to_sunset)
#Not normal W = 0.80697, p-value = 0.0000000001806
wilcox <- wilcox.test(fall_season$time_to_sunset, spring_season$time_to_sunset, paired = FALSE, var.equal = TRUE, alternative = "greater", conf.int = TRUE, conf.level = 0.95)
print(wilcox)
#Wilcoxon rank sum test with continuity correction
#data:  spring_sum_night$time_to_sunset and fall_sum_night$time_to_sunset
#W = 917, p-value = 0.008499**
#alternative hypothesis: true location shift is less than 0
#Significant difference between seasons!
wilcox_spring <- wilcox.test(spring_sekaa$time_to_sunset, spring_sekrn$time_to_sunset, paired = FALSE, var.equal = TRUE, alternative = "greater", conf.int = TRUE, conf.level = 0.95)
print(wilcox_spring)
ggplot(data = season_filter, aes(x = radar, y = time_to_sunset, fill = season)) +
stat_summary(fun.data="mean_sdl", fun.args = list(mult=1),
geom="errorbar", width=0.5, position = position_dodge(.75)) +
geom_boxplot() +
labs(x = "Radar", y = "Departure time after sunset (min)") +
theme(axis.title = element_text(size = 16), strip.text = element_text(size = 20), legend.text = element_text(size = 13), legend.title = element_text(size = 16))
wilcox_fall <- wilcox.test(fall_sekrn$time_to_sunset, fall_sekaa$time_to_sunset, paired = FALSE, var.equal = TRUE, alternative = "greater", conf.int = TRUE, conf.level = 0.95)
print(wilcox_fall)
